"use client";

import { useState } from "react";
import { Plus } from "lucide-react";
import Badge from "@/components/ui/Badge";
import Reveal from "@/components/ui/Reveal";
import { faqs } from "@/lib/home-content";

export default function FAQSection() {
  const [active, setActive] = useState<number | null>(0);

  return (
    <section id="faq" className="relative bg-background py-28">
      <div className="mx-auto max-w-4xl px-6 lg:px-8">
        <Reveal className="mx-auto max-w-2xl text-center">
          <Badge>FAQ</Badge>
          <h2 className="mt-6 text-3xl font-semibold tracking-tight sm:text-4xl">
            Questions,
            <span className="text-gradient"> answered.</span>
          </h2>
        </Reveal>

        <div className="mt-14 space-y-3">
          {faqs.map((item, i) => {
            const open = active === i;
            return (
              <Reveal key={item.q} delay={i * 60}>
                <div className="card-border overflow-hidden rounded-2xl">
                  <button
                    type="button"
                    onClick={() => setActive(open ? null : i)}
                    className="flex w-full cursor-pointer items-center justify-between gap-4 px-6 py-5 text-left"
                    aria-expanded={open}
                  >
                    <span className="font-medium text-foreground">{item.q}</span>
                    <Plus
                      size={18}
                      className={`flex-none text-accent-2 transition-transform duration-300 ${
                        open ? "rotate-45" : ""
                      }`}
                    />
                  </button>
                  <div
                    className="grid transition-all duration-300 ease-out"
                    style={{
                      gridTemplateRows: open ? "1fr" : "0fr",
                      opacity: open ? 1 : 0,
                    }}
                  >
                    <div className="overflow-hidden">
                      <p className="px-6 pb-5 text-sm leading-relaxed text-muted">{item.a}</p>
                    </div>
                  </div>
                </div>
              </Reveal>
            );
          })}
        </div>
      </div>
    </section>
  );
}
